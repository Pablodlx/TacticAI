APP_ENV=local
PORT=8000
LOG_LEVEL=INFO

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./runtime_data
GCS_INPUT_BUCKET=
GCS_OUTPUT_BUCKET=
GCP_PROJECT_ID=
GCP_REGION=europe-west1

QUEUE_BACKEND=sync
PUBSUB_TOPIC=tacticeye2-jobs
PUBSUB_SUBSCRIPTION=tacticeye2-jobs-sub
REDIS_URL=redis://redis:6379/0

DATABASE_URL=sqlite:///./runtime_data/jobs.db
ANTHROPIC_API_KEY=

MODEL_PATH=weights/best.pt
CONF_THRESHOLD=0.30
BATCH_SIZE_SECONDS=3.0

