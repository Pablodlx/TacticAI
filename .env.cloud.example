APP_ENV=cloud
PORT=8080
LOG_LEVEL=INFO
STORAGE_BACKEND=gcs
QUEUE_BACKEND=pubsub
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@/DB?host=/cloudsql/PROJECT:REGION:INSTANCE
GCP_PROJECT_ID=your-project
GCP_REGION=europe-west1
GCS_INPUT_BUCKET=your-input-bucket
GCS_OUTPUT_BUCKET=your-output-bucket
PUBSUB_TOPIC=tacticeye2-jobs
PUBSUB_SUBSCRIPTION=tacticeye2-jobs-sub
MODEL_PATH=weights/best.pt
CONF_THRESHOLD=0.30
BATCH_SIZE_SECONDS=3.0

